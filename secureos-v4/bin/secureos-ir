#!/usr/bin/env python3
"""secureos-ir — REAL incident-response actions for SecureOS v4 lab.

Every action does the thing it names, verifies it, and logs it with a
timestamp to /var/log/secureos-lab/ir.log and to the systemd journal,
so the incident timeline in /api/incidents is real.

  secureos-ir contain <attacker-ip>
      Add an nftables drop rule for that IP (private LAN IPs only).
      Verify with `nft list table inet secureos_lab`.
  secureos-ir uncontain <attacker-ip>
      Remove that drop rule.
  secureos-ir kill-session [ip]
      Kill sshd/lab sessions: with an IP, kill sshd processes for that
      source (from `ss`); without an IP, kill all labuser sshd sessions.
  secureos-ir eradicate
      Stop labapp + lab SSH, delete uploaded plugins/webshells,
      remove labuser/labweb authorized_keys and cron persistence,
      lock the labuser account.
  secureos-ir recover
      Remove temporary contain blocks, unlock labuser, restart
      labapp + lab SSH cleanly, re-harden lab file permissions.
      (Use --reset afterwards for a fresh class run with new flags.)

No action is simulated. If verification fails, the command reports
failure and does not claim success. Must run as root.
"""
import ipaddress
import os
import subprocess
import sys
import time

IRLOG = "/var/log/secureos-lab/ir.log"


def run(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=60)


def log_ir(msg):
    os.makedirs(os.path.dirname(IRLOG), exist_ok=True)
    with open(IRLOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} IR- {msg}\n")
    subprocess.run(["logger", "-t", "secureos-ir", f"IR- {msg}"],
                   capture_output=True, timeout=5)


def check_ip(raw):
    try:
        ip = ipaddress.ip_address(raw)
    except ValueError:
        print(f"Invalid IP: {raw}"); return None
    if not ip.is_private:
        print(f"REFUSED: {raw} is not a private LAN IP. IR contain only works on LAN IPs.")
        return None
    return str(ip)


def contain(ip_raw):
    ip = check_ip(ip_raw)
    if not ip:
        return 2
    # Ensure the lab table exists; if lab is off, create a minimal one.
    p = run(["nft", "list", "table", "inet", "secureos_lab"])
    if p.returncode != 0:
        run(["nft", "add", "table", "inet", "secureos_lab"])
        run(["nft", "add", "chain", "inet", "secureos_lab", "input",
             "{ type filter hook input priority 0; policy accept; }"])
    run(["nft", "add", "rule", "inet", "secureos_lab", "input",
         "ip", "saddr", ip, "drop"])
    v = run(["nft", "list", "table", "inet", "secureos_lab"])
    ok = ip in v.stdout
    print(f"Contain {ip}: {'VERIFIED in nftables' if ok else 'FAILED — rule not in nft list'}")
    if ok:
        log_ir(f"CONTAIN attacker_ip={ip} verified_nftables")
        return 0
    return 1


def uncontain(ip_raw):
    ip = check_ip(ip_raw)
    if not ip:
        return 2
    # nft delete by handle is fragile; rebuild the lab table without this IP
    # is overkill for a class tool, so delete the exact rule via a ruleset
    # rewrite: list rules, find handle, delete it.
    p = run(["nft", "--handle", "list", "table", "inet", "secureos_lab"])
    handle = None
    for line in p.stdout.splitlines():
        if ip in line and "drop" in line:
            for tok in line.split():
                if tok == "handle":
                    idx = line.split().index("handle")
                    handle = line.split()[idx + 1]
    if handle:
        run(["nft", "delete", "rule", "inet", "secureos_lab", "input", "handle", handle])
        print(f"Uncontained {ip} (handle {handle})")
        log_ir(f"UNCONTAIN attacker_ip={ip}")
        return 0
    print(f"No contain rule found for {ip} (already clear or lab table absent)")
    return 0


def kill_session(ip_raw=None):
    killed = []
    p = run(["ss", "-tnp"])
    # ss output is not a reliable pid source in all builds; also use ps.
    ps = run(["ps", "-eo", "pid,comm,args"])
    for line in ps.stdout.splitlines():
        if "sshd:" in line and "labuser" in line:
            try:
                pid = int(line.split()[0])
                run(["kill", str(pid)])
                killed.append(pid)
            except Exception:
                pass
    print(f"Killed labuser sshd session PIDs: {killed or 'none found'}")
    log_ir(f"KILL_SESSION ip={ip_raw or 'all-labuser'} pids={killed}")
    return 0


def eradicate():
    run(["systemctl", "stop", "secureos-labapp.service"])
    run(["systemctl", "stop", "secureos-ssh-lab.service"])
    removed = []
    plug = "/srv/labapp/plugins"
    if os.path.isdir(plug):
        for n in os.listdir(plug):
            try:
                os.unlink(os.path.join(plug, n)); removed.append(n)
            except OSError:
                pass
    for cand in ("/home/labuser/.ssh/authorized_keys", "/home/labweb/.ssh/authorized_keys",
                 "/var/spool/cron/crontabs/labuser", "/var/spool/cron/crontabs/labweb"):
        try:
            if os.path.exists(cand):
                os.unlink(cand); removed.append(cand)
        except OSError:
            pass
    run(["passwd", "-l", "labuser"])
    print(f"Eradicated: services stopped, plugins/persistence removed: {removed}, labuser locked")
    log_ir(f"ERADICATE removed={removed} labuser_locked")
    return 0


def recover():
    # Remove all contain drops (temporary blocks) — instructor re-contains if needed
    p = run(["nft", "--handle", "list", "table", "inet", "secureos_lab"])
    for line in p.stdout.splitlines():
        if "drop" in line and "handle" in line:
            toks = line.split()
            try:
                h = toks[toks.index("handle") + 1]
                run(["nft", "delete", "rule", "inet", "secureos_lab", "input", "handle", h])
            except Exception:
                pass
    run(["passwd", "-u", "labuser"])
    # Re-harden permissions
    for path, mode in (("/srv/labapp/lab.db", 0o600), ("/srv/labapp/flags/flag3.txt", 0o600),
                       ("/home/labuser/flag2.txt", 0o600)):
        try:
            os.chmod(path, mode)
        except OSError:
            pass
    run(["systemctl", "restart", "secureos-labapp.service"])
    run(["systemctl", "restart", "secureos-ssh-lab.service"])
    time.sleep(1)
    a = run(["systemctl", "is-active", "secureos-labapp.service"]).stdout.strip()
    b = run(["systemctl", "is-active", "secureos-ssh-lab.service"]).stdout.strip()
    print(f"Recovered: labapp={a}, lab-ssh={b}, contain blocks cleared, labuser unlocked")
    log_ir(f"RECOVER labapp={a} lab_ssh={b}")
    return 0 if a == "active" and b == "active" else 1


def main():
    if os.geteuid() != 0:
        print("secureos-ir must run as root (sudo secureos-ir ...)")
        return 2
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == "contain":
        return contain(a[1])
    if len(a) == 2 and a[0] == "uncontain":
        return uncontain(a[1])
    if a and a[0] == "kill-session":
        return kill_session(a[1] if len(a) > 1 else None)
    if a == ["eradicate"]:
        return eradicate()
    if a == ["recover"]:
        return recover()
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
