#!/bin/bash
# secureos-gui — start the SecureOS graphical desktop ON DEMAND.
# Default boot is CLI + web console on http://127.0.0.1:8000 (unchanged).
# This command does NOT change the default boot target.
# Usage: secureos-gui [--window|--fullscreen|--stop|--help]
#  --window     start XFCE in the QEMU display window (default)
#  --fullscreen start XFCE and ask it to use the largest mode via xrandr
#  --stop       stop the Xorg / XFCE session and return to the CLI
#  --help       show this help
set -u
MODE="window"
for a in "$@"; do
  case "$a" in
    --help|-h)
      echo "secureos-gui — start the SecureOS GUI on demand"
      echo "  secureos-gui             start XFCE (windowed, default)"
      echo "  secureos-gui --window    start XFCE (windowed)"
      echo "  secureos-gui --fullscreen start XFCE, largest mode via xrandr on session start"
      echo "  secureos-gui --stop      stop Xorg/XFCE and return to CLI"
      echo "Default boot stays CLI + web console at http://127.0.0.1:8000."
      echo "GUI stack: Xorg + XFCE, Thunar, xfce4-terminal, xfce4-taskmanager."
      echo "In the GUI, the SecureOS Console launcher opens http://127.0.0.1:8000 in a browser."
      exit 0 ;;
    --window) MODE="window" ;;
    --fullscreen) MODE="fullscreen" ;;
    --stop)
      echo "Stopping SecureOS GUI..."
      pkill -u "$USER" xfce4-session 2>/dev/null || true
      pkill -u "$USER" Xorg 2>/dev/null || true
      pkill -u "$USER" xfwm4 2>/dev/null || true
      echo "GUI stopped. You are back on the CLI. Web console still runs on http://127.0.0.1:8000."
      exit 0 ;;
    *) echo "Unknown option: $a (try secureos-gui --help)" >&2; exit 1 ;;
  esac
done
if pgrep -u "$USER" Xorg >/dev/null 2>&1; then
  echo "GUI is already running. Use secureos-gui --stop to stop it."
  exit 0
fi
command -v startx >/dev/null 2>&1 || { echo "ERROR: Xorg/startx is not installed in this image." >&2; exit 1; }
command -v startxfce4 >/dev/null 2>&1 || { echo "ERROR: startxfce4 is not installed in this image." >&2; exit 1; }
# Session autostart helpers (idempotent)
mkdir -p "$HOME/.config/autostart"
cat > "$HOME/.config/autostart/secureos-console.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=SecureOS Console
Exec=firefox-esr http://127.0.0.1:8000
Comment=Open the local SecureOS web console
X-GNOME-Autostart-enabled=true
EOF
cat > "$HOME/.config/autostart/nm-applet.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Network
Exec=nm-applet
X-GNOME-Autostart-enabled=true
EOF
if [ "$MODE" = "fullscreen" ]; then
  cat > "$HOME/.config/autostart/secureos-fullscreen.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=SecureOS Fullscreen
Exec=sh -c "sleep 2; xrandr -s 1920x1080 2>/dev/null || xrandr --output default --mode 1920x1080 2>/dev/null || true"
X-GNOME-Autostart-enabled=true
EOF
  echo "Starting SecureOS GUI (fullscreen request: largest mode via xrandr on session start)..."
else
  rm -f "$HOME/.config/autostart/secureos-fullscreen.desktop"
  echo "Starting SecureOS GUI (windowed)..."
fi
cat > "$HOME/.xinitrc" <<'EOF'
#!/bin/sh
exec startxfce4
EOF
chmod +x "$HOME/.xinitrc"
echo "Tip: quit the GUI from the XFCE log-out menu, or run secureos-gui --stop from another console."
echo "Web console stays at http://127.0.0.1:8000."
exec startx
