#!/bin/bash
# secureos-drivers — real driver/hardware summary. Never claims a driver
# that is not actually installed/loaded.
echo "=== PCI devices (lspci) ==="
command -v lspci >/dev/null 2>&1 && lspci || echo "lspci: not installed"
echo
echo "=== USB devices (lsusb) ==="
command -v lsusb >/dev/null 2>&1 && lsusb || echo "lsusb: not installed"
echo
echo "=== Loaded kernel modules (lsmod, first 30) ==="
command -v lsmod >/dev/null 2>&1 && lsmod | head -30 || echo "lsmod: not installed"
echo
echo "=== Hardware summary (lshw -short, first 30) ==="
command -v lshw >/dev/null 2>&1 && lshw -short 2>/dev/null | head -30 || echo "lshw: not installed"
