#!/bin/bash
# secureos-status — one screen: kernel, service, network, battery, disk, GUI.
echo "=== SecureOS status ==="
echo "Kernel:  $(uname -r)  ($(cat /proc/version 2>/dev/null | cut -d' ' -f1-3))"
echo "Uptime:  $(uptime -p 2>/dev/null || cat /proc/uptime)"
echo "Console: $(systemctl is-active secureos.service 2>/dev/null || echo unknown)  http://127.0.0.1:8000"
echo "GUI:     $(pgrep -u "$USER" Xorg >/dev/null 2>&1 && echo "running (use secureos-gui --stop to stop)" || echo "not running (run secureos-gui to start it)")"
echo "--- Network ---"
ip -brief addr 2>/dev/null || ip addr 2>/dev/null | head -20
nmcli device status 2>/dev/null || echo "nmcli: not available"
echo "--- Disk / Memory ---"
df -h / 2>/dev/null | tail -1
free -h 2>/dev/null | head -2
echo "--- Battery ---"
if command -v upower >/dev/null 2>&1; then
  upower -e 2>/dev/null | grep -i battery | while read -r dev; do upower -i "$dev" 2>/dev/null | grep -E "percentage:|state:"; done
  upower -e 2>/dev/null | grep -qi battery || echo "No battery detected (VM / AC power)"
else
  echo "upower: not installed"
fi
