#!/bin/bash
# secureos-logs — real system logs. Usage: secureos-logs [N]  (default 100)
N="${1:-100}"
echo "=== systemd journal (last $N lines) ==="
journalctl -n "$N" --no-pager 2>&1 | tail -n "$N"
echo
echo "=== /var/log/auth.log (tail) ==="
tail -n 20 /var/log/auth.log 2>&1 | tail -20
echo
echo "=== /var/log/syslog (tail) ==="
tail -n 20 /var/log/syslog 2>&1 | tail -20
